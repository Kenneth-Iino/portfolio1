---
import projectData from './Data/Projects.json';
---

<section class="overflow-hidden bg-black pt-14 pb-32 space-y-24 relative" id="projects">
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
        <!-- Floating Geometric Shapes -->
        <div class="absolute top-20 left-10 w-32 h-32 bg-gradient-to-br from-blue-500/10 to-purple-500/10 rounded-full blur-xl animate-pulse"></div>
        <div class="absolute top-40 right-20 w-24 h-24 bg-gradient-to-br from-green-500/10 to-teal-500/10 rounded-full blur-lg animate-bounce"></div>
        <div class="absolute bottom-40 left-1/4 w-40 h-40 bg-gradient-to-br from-orange-500/10 to-red-500/10 rounded-full blur-2xl animate-pulse"></div>
        <div class="absolute bottom-20 right-1/3 w-28 h-28 bg-gradient-to-br from-pink-500/10 to-purple-500/10 rounded-full blur-xl animate-bounce"></div>
        
        <!-- Grid Pattern -->
        <div class="absolute inset-0 opacity-5">
            <div class="grid grid-cols-12 gap-4 h-full">
                {Array.from({length: 12}).map(() => (
                    <div class="border-r border-white/10 h-full"></div>
                ))}
            </div>
        </div>
        
        <!-- Diagonal Lines -->
        <div class="absolute inset-0 opacity-10">
            <svg class="w-full h-full" viewBox="0 0 1200 800" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <pattern id="diagonal-lines" patternUnits="userSpaceOnUse" width="60" height="60">
                        <path d="M0 60L60 0" stroke="white" stroke-width="0.5" opacity="0.3"/>
                    </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#diagonal-lines)"/>
            </svg>
        </div>
        
        <!-- Floating Code Elements -->
        <div class="absolute top-32 left-1/4 text-white/5 font-mono text-sm transform rotate-12 animate-pulse">
            <div>&lt;div className="project"&gt;</div>
            <div>&nbsp;&nbsp;{`{data.map(item =>`}</div>
            <div>&nbsp;&nbsp;&nbsp;&nbsp;&lt;Component /&gt;</div>
            <div>&nbsp;&nbsp;)}</div>
            <div>&lt;/div&gt;</div>
        </div>
        
        <div class="absolute bottom-32 right-1/4 text-white/5 font-mono text-sm transform -rotate-12 animate-pulse">
            <div>const projects = [</div>
            <div>&nbsp;&nbsp;{ name: "Dashboard" },</div>
            <div>&nbsp;&nbsp;{ type: "Analytics" },</div>
            <div>&nbsp;&nbsp;{ tech: "React" }</div>
            <div>];</div>
        </div>
        
        <!-- Animated Dots -->
        <div class="absolute top-1/4 left-1/2 w-2 h-2 bg-blue-400/30 rounded-full animate-ping"></div>
        <div class="absolute top-3/4 left-1/3 w-3 h-3 bg-green-400/30 rounded-full animate-ping" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 right-1/4 w-2 h-2 bg-purple-400/30 rounded-full animate-ping" style="animation-delay: 2s;"></div>
        
        <!-- Circuit Board Pattern -->
        <div class="absolute top-0 right-0 w-96 h-96 opacity-5">
            <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 20H180V180H20V20Z" stroke="white" stroke-width="0.5"/>
                <circle cx="40" cy="40" r="3" fill="white"/>
                <circle cx="160" cy="40" r="3" fill="white"/>
                <circle cx="40" cy="160" r="3" fill="white"/>
                <circle cx="160" cy="160" r="3" fill="white"/>
                <path d="M40 40H160M40 160H160M40 40V160M160 40V160" stroke="white" stroke-width="0.5"/>
                <path d="M100 20V180M20 100H180" stroke="white" stroke-width="0.5"/>
            </svg>
        </div>
        
        <!-- Data Visualization Elements -->
        <div class="absolute bottom-0 left-0 w-80 h-80 opacity-5">
            <svg viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="50" y="200" width="20" height="80" fill="white"/>
                <rect x="80" y="150" width="20" height="130" fill="white"/>
                <rect x="110" y="100" width="20" height="180" fill="white"/>
                <rect x="140" y="120" width="20" height="160" fill="white"/>
                <rect x="170" y="80" width="20" height="200" fill="white"/>
                <rect x="200" y="160" width="20" height="120" fill="white"/>
                <rect x="230" y="180" width="20" height="100" fill="white"/>
            </svg>
        </div>
    </div>
    
    <!-- Content -->
    <div class="relative z-10">
        <div class="self-stretch overflow-hidden flex flex-row items-center justify-center py-5 px-0 gap-[16px]">
            <h2 class="text-white py-5 text-4xl font-bold sm:text-4xl md:text-5xl"><span class="font-medium">My</span> Projects</h2>
        </div>
        
        {projectData.map((project, index) => (
            <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Project-specific background elements -->
                <div class="absolute inset-0 overflow-hidden pointer-events-none">
                    <!-- Unique gradient for each project -->
                    <div class={`absolute -top-20 -right-20 w-96 h-96 bg-gradient-to-br ${
                        index === 0 ? 'from-blue-500/5 to-purple-500/5' :
                        index === 1 ? 'from-green-500/5 to-teal-500/5' :
                        'from-orange-500/5 to-red-500/5'
                    } rounded-full blur-3xl`}></div>
                    
                    <!-- Floating tech icons -->
                    <div class={`absolute top-10 ${index % 2 === 0 ? 'left-10' : 'right-10'} text-white/5 text-6xl animate-pulse`}>
                        {index === 0 ? '📊' : index === 1 ? '🤖' : '🔍'}
                    </div>
                </div>

                <!-- Project Header -->
                <div class="text-center mb-12 relative">
                    <div class="inline-flex items-center gap-3 mb-4">
                        <span class="text-4xl font-bold text-white bg-gradient-to-r from-white to-zinc-400 bg-clip-text text-transparent">
                            {String(index + 1).padStart(2, '0')}
                        </span>
                        <div class="w-16 h-1 bg-gradient-to-r from-white to-zinc-400 rounded-full"></div>
                    </div>
                    <h3 class="text-3xl md:text-4xl font-bold text-white mb-4">
                        {project.name}
                    </h3>
                    <p class="text-lg text-zinc-400 max-w-3xl mx-auto mb-6">
                        {project.description}
                    </p>
                    <div class="flex flex-wrap justify-center gap-3 mb-8">
                        {project.tags && project.tags.map(tag => (
                            <span class="px-4 py-2 bg-white/10 backdrop-blur-sm border border-white/20 text-zinc-300 text-sm rounded-full hover:bg-white/20 transition-colors">
                                {tag}
                            </span>
                        ))}
                    </div>
                </div>

                <!-- Main Project Showcase with Carousel -->
                <div class="relative mb-12">
                    <!-- Carousel Container -->
                    <div class={`carousel-container-${index} relative overflow-hidden rounded-2xl bg-zinc-900 border border-zinc-700 shadow-2xl`}>
                        <!-- Browser Frame -->
                        <div class="bg-zinc-800 p-4 border-b border-zinc-700">
                            <div class="flex items-center gap-3">
                                <div class="flex gap-2">
                                    <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                                    <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                                    <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                                </div>
                                <div class="flex-1 mx-4">
                                    <div class="bg-zinc-700 rounded-lg px-4 py-2 text-sm text-zinc-300 max-w-md">
                                        https://{project.name.toLowerCase().replace(/\s+/g, '-')}.com
                                    </div>
                                </div>
                                <div class="flex gap-2">
                                    <button class={`carousel-prev-${index} w-8 h-8 bg-zinc-700 hover:bg-zinc-600 rounded-lg flex items-center justify-center transition-colors`}>
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M10 12L6 8L10 4" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                    <button class={`carousel-next-${index} w-8 h-8 bg-zinc-700 hover:bg-zinc-600 rounded-lg flex items-center justify-center transition-colors`}>
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M6 4L10 8L6 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Carousel Images -->
                        <div class={`carousel-track-${index} flex transition-transform duration-500 ease-in-out`}>
                            <!-- Main Dashboard View -->
                            <div class="carousel-slide w-full flex-shrink-0 relative">
                                <img 
                                    src={`https://images.pexels.com/photos/${project.id === 1 ? '590022' : project.id === 2 ? '8386440' : '270348'}/pexels-photo-${project.id === 1 ? '590022' : project.id === 2 ? '8386440' : '270348'}.jpeg?auto=compress&cs=tinysrgb&w=1200`}
                                    alt={`${project.name} - Main Dashboard`}
                                    class="w-full h-96 md:h-[500px] object-cover"
                                />
                                <div class="absolute bottom-6 left-6 right-6 bg-black/80 backdrop-blur-sm rounded-lg p-4 border border-white/20">
                                    <h4 class="text-white font-semibold text-lg mb-2">Main Dashboard</h4>
                                    <p class="text-zinc-300 text-sm">Primary interface showcasing the main features and navigation of the application</p>
                                </div>
                            </div>

                            <!-- Mobile Responsive View -->
                            <div class="carousel-slide w-full flex-shrink-0 relative">
                                <img 
                                    src={`https://images.pexels.com/photos/${project.id === 1 ? '3184291' : project.id === 2 ? '4348401' : '3184465'}/pexels-photo-${project.id === 1 ? '3184291' : project.id === 2 ? '4348401' : '3184465'}.jpeg?auto=compress&cs=tinysrgb&w=1200`}
                                    alt={`${project.name} - Mobile View`}
                                    class="w-full h-96 md:h-[500px] object-cover"
                                />
                                <div class="absolute bottom-6 left-6 right-6 bg-black/80 backdrop-blur-sm rounded-lg p-4 border border-white/20">
                                    <h4 class="text-white font-semibold text-lg mb-2">Mobile Responsive</h4>
                                    <p class="text-zinc-300 text-sm">Fully optimized mobile experience with touch-friendly interface and responsive design</p>
                                </div>
                            </div>

                            <!-- Analytics/Admin View -->
                            <div class="carousel-slide w-full flex-shrink-0 relative">
                                <img 
                                    src={`https://images.pexels.com/photos/${project.id === 1 ? '196644' : project.id === 2 ? '3184360' : '3184639'}/pexels-photo-${project.id === 1 ? '196644' : project.id === 2 ? '3184360' : '3184639'}.jpeg?auto=compress&cs=tinysrgb&w=1200`}
                                    alt={`${project.name} - Analytics View`}
                                    class="w-full h-96 md:h-[500px] object-cover"
                                />
                                <div class="absolute bottom-6 left-6 right-6 bg-black/80 backdrop-blur-sm rounded-lg p-4 border border-white/20">
                                    <h4 class="text-white font-semibold text-lg mb-2">Analytics Dashboard</h4>
                                    <p class="text-zinc-300 text-sm">Comprehensive data insights, reporting tools, and administrative controls</p>
                                </div>
                            </div>
                        </div>

                        <!-- Carousel Indicators -->
                        <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2">
                            <button class={`carousel-indicator-${index} w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors`} data-slide="0"></button>
                            <button class={`carousel-indicator-${index} w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors`} data-slide="1"></button>
                            <button class={`carousel-indicator-${index} w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors`} data-slide="2"></button>
                        </div>
                    </div>
                </div>

                <!-- Feature Highlights -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                    <div class="bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:bg-white/10 transition-colors group">
                        <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2L13.09 8.26L22 9L13.09 9.74L12 16L10.91 9.74L2 9L10.91 8.26L12 2Z" fill="white"/>
                            </svg>
                        </div>
                        <h4 class="text-white font-semibold mb-2">User Experience</h4>
                        <p class="text-zinc-400 text-sm">Intuitive interface design with seamless navigation and user-friendly interactions</p>
                    </div>

                    <div class="bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:bg-white/10 transition-colors group">
                        <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-teal-600 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM9 17H7V10H9V17ZM13 17H11V7H13V17ZM17 17H15V13H17V17Z" fill="white"/>
                            </svg>
                        </div>
                        <h4 class="text-white font-semibold mb-2">Performance</h4>
                        <p class="text-zinc-400 text-sm">Optimized for speed with efficient data processing and real-time updates</p>
                    </div>

                    <div class="bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:bg-white/10 transition-colors group">
                        <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-red-600 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM10 17L6 13L7.41 11.59L10 14.17L16.59 7.58L18 9L10 17Z" fill="white"/>
                            </svg>
                        </div>
                        <h4 class="text-white font-semibold mb-2">Security</h4>
                        <p class="text-zinc-400 text-sm">Built with security best practices and data protection measures</p>
                    </div>
                </div>

                <!-- Project Actions -->
                <div class="text-center">
                    <a href={project.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-white text-black px-8 py-4 rounded-lg font-semibold hover:bg-zinc-200 transition-colors group">
                        <span>View Live Project</span>
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="group-hover:translate-x-1 transition-transform">
                            <path d="M4 10H16M16 10L12 6M16 10L12 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                </div>

                <!-- Separator for next project -->
                {index < projectData.length - 1 && (
                    <div class="mt-24 flex justify-center">
                        <div class="w-32 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
                    </div>
                )}
            </div>
        ))}
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize carousels for each project
    const projectCount = document.querySelectorAll('[class*="carousel-container-"]').length;
    
    for (let i = 0; i < projectCount; i++) {
        initializeCarousel(i);
    }
    
    function initializeCarousel(index) {
        const track = document.querySelector(`.carousel-track-${index}`);
        const slides = track.querySelectorAll('.carousel-slide');
        const nextButton = document.querySelector(`.carousel-next-${index}`);
        const prevButton = document.querySelector(`.carousel-prev-${index}`);
        const indicators = document.querySelectorAll(`.carousel-indicator-${index}`);
        
        let currentSlide = 0;
        const totalSlides = slides.length;
        
        // Update carousel position
        function updateCarousel() {
            const translateX = -currentSlide * 100;
            track.style.transform = `translateX(${translateX}%)`;
            
            // Update indicators
            indicators.forEach((indicator, idx) => {
                if (idx === currentSlide) {
                    indicator.classList.remove('bg-white/50');
                    indicator.classList.add('bg-white');
                } else {
                    indicator.classList.remove('bg-white');
                    indicator.classList.add('bg-white/50');
                }
            });
        }
        
        // Next slide
        nextButton.addEventListener('click', () => {
            currentSlide = (currentSlide + 1) % totalSlides;
            updateCarousel();
        });
        
        // Previous slide
        prevButton.addEventListener('click', () => {
            currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
            updateCarousel();
        });
        
        // Indicator clicks
        indicators.forEach((indicator, idx) => {
            indicator.addEventListener('click', () => {
                currentSlide = idx;
                updateCarousel();
            });
        });
        
        // Auto-play carousel
        setInterval(() => {
            currentSlide = (currentSlide + 1) % totalSlides;
            updateCarousel();
        }, 5000);
        
        // Initialize first slide
        updateCarousel();
    }
});
</script>

<style>
/* Custom animations for background elements */
@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.animate-float {
    animation: float 6s ease-in-out infinite;
}

.animate-rotate-slow {
    animation: rotate 20s linear infinite;
}
</style>