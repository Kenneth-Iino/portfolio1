---
import projectData from './Data/Projects.json';
---

<section class="overflow-hidden bg-black pt-14 pb-32 space-y-24" id="projects">
    <div class="self-stretch overflow-hidden flex flex-row items-center justify-center py-5 px-0 gap-[16px]">
        <h2 class="text-white py-5 text-4xl font-bold sm:text-4xl md:text-5xl"><span class="font-medium">My</span> Projects</h2>
    </div>
    
    {projectData.map((project, index) => (
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Project Header -->
            <div class="text-center mb-12">
                <div class="inline-flex items-center gap-3 mb-4">
                    <span class="text-4xl font-bold text-white bg-gradient-to-r from-white to-zinc-400 bg-clip-text text-transparent">
                        {String(index + 1).padStart(2, '0')}
                    </span>
                    <div class="w-16 h-1 bg-gradient-to-r from-white to-zinc-400 rounded-full"></div>
                </div>
                <h3 class="text-3xl md:text-4xl font-bold text-white mb-4">
                    {project.name}
                </h3>
                <p class="text-lg text-zinc-400 max-w-3xl mx-auto mb-6">
                    {project.description}
                </p>
                <div class="flex flex-wrap justify-center gap-3 mb-8">
                    {project.tags && project.tags.map(tag => (
                        <span class="px-4 py-2 bg-white/10 backdrop-blur-sm border border-white/20 text-zinc-300 text-sm rounded-full hover:bg-white/20 transition-colors">
                            {tag}
                        </span>
                    ))}
                </div>
            </div>

            <!-- Website Showcase Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
                <!-- Main Desktop View -->
                <div class="lg:col-span-2">
                    <div class="relative group">
                        <!-- Browser Frame -->
                        <div class="bg-zinc-800 rounded-t-xl p-3 border-b border-zinc-700">
                            <div class="flex items-center gap-2">
                                <div class="flex gap-2">
                                    <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                                    <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                                    <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                                </div>
                                <div class="flex-1 mx-4">
                                    <div class="bg-zinc-700 rounded px-3 py-1 text-xs text-zinc-400">
                                        {project.name.toLowerCase().replace(/\s+/g, '-')}.com
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Main Screenshot -->
                        <div class="relative overflow-hidden rounded-b-xl bg-white">
                            <img 
                                src={`https://images.pexels.com/photos/${project.id === 1 ? '590022' : project.id === 2 ? '8386440' : '270348'}/pexels-photo-${project.id === 1 ? '590022' : project.id === 2 ? '8386440' : '270348'}.jpeg?auto=compress&cs=tinysrgb&w=800`}
                                alt={`${project.name} - Main Dashboard`}
                                class="w-full h-80 object-cover group-hover:scale-105 transition-transform duration-500"
                            />
                            <!-- Overlay with project info -->
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                <div class="absolute bottom-4 left-4 right-4">
                                    <h4 class="text-white font-semibold mb-2">Main Dashboard</h4>
                                    <p class="text-zinc-300 text-sm">Primary interface and navigation</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Secondary Views -->
                <div class="space-y-6">
                    <!-- Mobile View -->
                    <div class="relative group">
                        <div class="bg-zinc-800 rounded-t-lg p-2">
                            <div class="flex items-center justify-center">
                                <div class="w-16 h-1 bg-zinc-600 rounded-full"></div>
                            </div>
                        </div>
                        <div class="relative overflow-hidden rounded-b-lg bg-white">
                            <img 
                                src={`https://images.pexels.com/photos/${project.id === 1 ? '3184291' : project.id === 2 ? '4348401' : '3184465'}/pexels-photo-${project.id === 1 ? '3184291' : project.id === 2 ? '4348401' : '3184465'}.jpeg?auto=compress&cs=tinysrgb&w=400`}
                                alt={`${project.name} - Mobile View`}
                                class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                <div class="absolute bottom-2 left-2 right-2">
                                    <h4 class="text-white font-semibold text-sm mb-1">Mobile Responsive</h4>
                                    <p class="text-zinc-300 text-xs">Optimized for mobile devices</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Analytics/Admin View -->
                    <div class="relative group">
                        <div class="bg-zinc-800 rounded-t-lg p-2">
                            <div class="flex items-center gap-1">
                                <div class="w-2 h-2 bg-red-500 rounded-full"></div>
                                <div class="w-2 h-2 bg-yellow-500 rounded-full"></div>
                                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                            </div>
                        </div>
                        <div class="relative overflow-hidden rounded-b-lg bg-white">
                            <img 
                                src={`https://images.pexels.com/photos/${project.id === 1 ? '196644' : project.id === 2 ? '3184360' : '3184639'}/pexels-photo-${project.id === 1 ? '196644' : project.id === 2 ? '3184360' : '3184639'}.jpeg?auto=compress&cs=tinysrgb&w=400`}
                                alt={`${project.name} - Analytics View`}
                                class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                <div class="absolute bottom-2 left-2 right-2">
                                    <h4 class="text-white font-semibold text-sm mb-1">Analytics Dashboard</h4>
                                    <p class="text-zinc-300 text-xs">Data insights and reporting</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Feature Highlights -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                <div class="bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:bg-white/10 transition-colors">
                    <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center mb-4">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L13.09 8.26L22 9L13.09 9.74L12 16L10.91 9.74L2 9L10.91 8.26L12 2Z" fill="white"/>
                        </svg>
                    </div>
                    <h4 class="text-white font-semibold mb-2">User Experience</h4>
                    <p class="text-zinc-400 text-sm">Intuitive interface design with seamless navigation and user-friendly interactions</p>
                </div>

                <div class="bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:bg-white/10 transition-colors">
                    <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-teal-600 rounded-lg flex items-center justify-center mb-4">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM9 17H7V10H9V17ZM13 17H11V7H13V17ZM17 17H15V13H17V17Z" fill="white"/>
                        </svg>
                    </div>
                    <h4 class="text-white font-semibold mb-2">Performance</h4>
                    <p class="text-zinc-400 text-sm">Optimized for speed with efficient data processing and real-time updates</p>
                </div>

                <div class="bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:bg-white/10 transition-colors">
                    <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-red-600 rounded-lg flex items-center justify-center mb-4">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM10 17L6 13L7.41 11.59L10 14.17L16.59 7.58L18 9L10 17Z" fill="white"/>
                        </svg>
                    </div>
                    <h4 class="text-white font-semibold mb-2">Security</h4>
                    <p class="text-zinc-400 text-sm">Built with security best practices and data protection measures</p>
                </div>
            </div>

            <!-- Project Actions -->
            <div class="text-center">
                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                    <a href={project.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-white text-black px-8 py-4 rounded-lg font-semibold hover:bg-zinc-200 transition-colors group">
                        <span>View Live Project</span>
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="group-hover:translate-x-1 transition-transform">
                            <path d="M10.293 3.293L6 7.586L7.414 9L10 6.414V17H12V6.414L14.586 9L16 7.586L11.707 3.293C11.316 2.902 10.684 2.902 10.293 3.293Z" fill="currentColor"/>
                        </svg>
                    </a>
                    <button class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/20 text-white px-8 py-4 rounded-lg font-semibold hover:bg-white/20 transition-colors">
                        <span>View Case Study</span>
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10 12L6 8H8V4H12V8H14L10 12ZM4 14V16H16V14H18V16C18 17.1 17.1 18 16 18H4C2.9 18 2 17.1 2 16V14H4Z" fill="white"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Separator for next project -->
            {index < projectData.length - 1 && (
                <div class="mt-24 flex justify-center">
                    <div class="w-32 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
                </div>
            )}
        </div>
    ))}
</section>