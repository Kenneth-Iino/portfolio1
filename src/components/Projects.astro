---
import projectData from './Data/Projects.json';
---

<section class="overflow-hidden bg-black pt-14 pb-32 space-y-24" id="projects">
    <div class="self-stretch overflow-hidden flex flex-row items-center justify-center py-5 px-0 gap-[16px]">
        <h2 class="text-white py-5 text-4xl font-bold sm:text-4xl md:text-5xl"><span class="font-medium">My</span> Projects</h2>
    </div>
    
    {projectData.map((project, index) => (
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Project Header -->
            <div class="text-center mb-12">
                <h3 class="text-3xl md:text-4xl font-bold text-white mb-4">
                    {project.name}
                </h3>
                <p class="text-lg text-zinc-400 max-w-3xl mx-auto mb-6">
                    {project.description}
                </p>
                <div class="flex flex-wrap justify-center gap-3 mb-8">
                    {project.tags && project.tags.map(tag => (
                        <span class="px-4 py-2 bg-white/10 backdrop-blur-sm border border-white/20 text-zinc-300 text-sm rounded-full hover:bg-white/20 transition-colors">
                            {tag}
                        </span>
                    ))}
                </div>
            </div>

            <!-- Enhanced Carousel with Peek View -->
            <div class="relative mb-12">
                <!-- Carousel Container with Peek View -->
                <div class={`carousel-container-${index} relative rounded-2xl bg-zinc-900 border border-zinc-700 shadow-2xl overflow-visible`}>
                    <!-- Browser Frame -->
                    <div class="bg-zinc-800 p-4 border-b border-zinc-700 relative z-10">
                        <div class="flex items-center gap-3">
                            <div class="flex gap-2">
                                <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                                <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                                <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                            </div>
                            <div class="flex-1 mx-4">
                                <div class="bg-zinc-700 rounded-lg px-4 py-2 text-sm text-zinc-300 max-w-md">
                                    https://{project.name.toLowerCase().replace(/\s+/g, '-')}.com
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <button class={`carousel-prev-${index} w-8 h-8 bg-zinc-700 hover:bg-zinc-600 rounded-lg flex items-center justify-center transition-colors z-20`}>
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M10 12L6 8L10 4" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                                <button class={`carousel-next-${index} w-8 h-8 bg-zinc-700 hover:bg-zinc-600 rounded-lg flex items-center justify-center transition-colors z-20`}>
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M6 4L10 8L6 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Enhanced Carousel Track with Peek View -->
                    <div class="relative overflow-hidden">
                        <div class={`carousel-track-${index} flex transition-all duration-700 ease-in-out`} style="transform: translateX(-33.333%);">
                            <!-- Previous slide (peek) -->
                            <div class="carousel-slide w-1/3 flex-shrink-0 relative opacity-50 scale-90 transition-all duration-700">
                                <img 
                                    src={`https://images.pexels.com/photos/${project.id === 1 ? '3184639' : project.id === 2 ? '3184360' : '196644'}/pexels-photo-${project.id === 1 ? '3184639' : project.id === 2 ? '3184360' : '196644'}.jpeg?auto=compress&cs=tinysrgb&w=800`}
                                    alt={`${project.name} - Analytics View`}
                                    class="w-full h-96 md:h-[400px] object-cover rounded-lg"
                                />
                            </div>

                            <!-- Current slide (main) -->
                            <div class="carousel-slide w-1/3 flex-shrink-0 relative scale-100 transition-all duration-700">
                                <img 
                                    src={`https://images.pexels.com/photos/${project.id === 1 ? '590022' : project.id === 2 ? '8386440' : '270348'}/pexels-photo-${project.id === 1 ? '590022' : project.id === 2 ? '8386440' : '270348'}.jpeg?auto=compress&cs=tinysrgb&w=1200`}
                                    alt={`${project.name} - Main Dashboard`}
                                    class="w-full h-96 md:h-[400px] object-cover rounded-lg"
                                />
                                <div class="absolute bottom-6 left-6 right-6 bg-black/80 backdrop-blur-sm rounded-lg p-4 border border-white/20">
                                    <h4 class="text-white font-semibold text-lg mb-2">Main Dashboard</h4>
                                    <p class="text-zinc-300 text-sm">Primary interface showcasing the main features and navigation</p>
                                </div>
                            </div>

                            <!-- Next slide (peek) -->
                            <div class="carousel-slide w-1/3 flex-shrink-0 relative opacity-50 scale-90 transition-all duration-700">
                                <img 
                                    src={`https://images.pexels.com/photos/${project.id === 1 ? '3184291' : project.id === 2 ? '4348401' : '3184465'}/pexels-photo-${project.id === 1 ? '3184291' : project.id === 2 ? '4348401' : '3184465'}.jpeg?auto=compress&cs=tinysrgb&w=800`}
                                    alt={`${project.name} - Mobile View`}
                                    class="w-full h-96 md:h-[400px] object-cover rounded-lg"
                                />
                            </div>

                            <!-- Duplicate slides for infinite loop -->
                            <div class="carousel-slide w-1/3 flex-shrink-0 relative opacity-50 scale-90 transition-all duration-700">
                                <img 
                                    src={`https://images.pexels.com/photos/${project.id === 1 ? '3184639' : project.id === 2 ? '3184360' : '196644'}/pexels-photo-${project.id === 1 ? '3184639' : project.id === 2 ? '3184360' : '196644'}.jpeg?auto=compress&cs=tinysrgb&w=800`}
                                    alt={`${project.name} - Analytics View`}
                                    class="w-full h-96 md:h-[400px] object-cover rounded-lg"
                                />
                            </div>

                            <div class="carousel-slide w-1/3 flex-shrink-0 relative scale-100 transition-all duration-700">
                                <img 
                                    src={`https://images.pexels.com/photos/${project.id === 1 ? '590022' : project.id === 2 ? '8386440' : '270348'}/pexels-photo-${project.id === 1 ? '590022' : project.id === 2 ? '8386440' : '270348'}.jpeg?auto=compress&cs=tinysrgb&w=1200`}
                                    alt={`${project.name} - Main Dashboard`}
                                    class="w-full h-96 md:h-[400px] object-cover rounded-lg"
                                />
                            </div>

                            <div class="carousel-slide w-1/3 flex-shrink-0 relative opacity-50 scale-90 transition-all duration-700">
                                <img 
                                    src={`https://images.pexels.com/photos/${project.id === 1 ? '3184291' : project.id === 2 ? '4348401' : '3184465'}/pexels-photo-${project.id === 1 ? '3184291' : project.id === 2 ? '4348401' : '3184465'}.jpeg?auto=compress&cs=tinysrgb&w=800`}
                                    alt={`${project.name} - Mobile View`}
                                    class="w-full h-96 md:h-[400px] object-cover rounded-lg"
                                />
                            </div>
                        </div>
                    </div>

                    <!-- Carousel Indicators -->
                    <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2 z-10">
                        <button class={`carousel-indicator-${index} w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors`} data-slide="0"></button>
                        <button class={`carousel-indicator-${index} w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors`} data-slide="1"></button>
                        <button class={`carousel-indicator-${index} w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors`} data-slide="2"></button>
                    </div>
                </div>
            </div>

            <!-- Feature Highlights -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                <div class="bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:bg-white/10 transition-colors group">
                    <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L13.09 8.26L22 9L13.09 9.74L12 16L10.91 9.74L2 9L10.91 8.26L12 2Z" fill="white"/>
                        </svg>
                    </div>
                    <h4 class="text-white font-semibold mb-2">User Experience</h4>
                    <p class="text-zinc-400 text-sm">Intuitive interface design with seamless navigation and user-friendly interactions</p>
                </div>

                <div class="bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:bg-white/10 transition-colors group">
                    <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-teal-600 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM9 17H7V10H9V17ZM13 17H11V7H13V17ZM17 17H15V13H17V17Z" fill="white"/>
                        </svg>
                    </div>
                    <h4 class="text-white font-semibold mb-2">Performance</h4>
                    <p class="text-zinc-400 text-sm">Optimized for speed with efficient data processing and real-time updates</p>
                </div>

                <div class="bg-white/5 backdrop-blur-sm rounded-xl p-6 border border-white/10 hover:bg-white/10 transition-colors group">
                    <div class="w-12 h-12 bg-gradient-to-br from-orange-500 to-red-600 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM10 17L6 13L7.41 11.59L10 14.17L16.59 7.58L18 9L10 17Z" fill="white"/>
                        </svg>
                    </div>
                    <h4 class="text-white font-semibold mb-2">Security</h4>
                    <p class="text-zinc-400 text-sm">Built with security best practices and data protection measures</p>
                </div>
            </div>

            <!-- Project Actions -->
            <div class="text-center">
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-white text-black px-8 py-4 rounded-lg font-semibold hover:bg-zinc-200 transition-colors group">
                    <span>View Live Project</span>
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="group-hover:translate-x-1 transition-transform">
                        <path d="M4 10H16M16 10L12 6M16 10L12 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>

            <!-- Separator for next project -->
            {index < projectData.length - 1 && (
                <div class="mt-24 flex justify-center">
                    <div class="w-32 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
                </div>
            )}
        </div>
    ))}
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const projectCount = document.querySelectorAll('[class*="carousel-container-"]').length;
    
    for (let i = 0; i < projectCount; i++) {
        initializeCarousel(i);
    }
    
    function initializeCarousel(index) {
        const track = document.querySelector(`.carousel-track-${index}`);
        const slides = track.querySelectorAll('.carousel-slide');
        const nextButton = document.querySelector(`.carousel-next-${index}`);
        const prevButton = document.querySelector(`.carousel-prev-${index}`);
        const indicators = document.querySelectorAll(`.carousel-indicator-${index}`);
        
        let currentSlide = 0;
        const totalSlides = 3; // We have 3 unique slides
        let isAnimating = false;
        
        // Update carousel position with peek view
        function updateCarousel(animate = true) {
            if (isAnimating && animate) return;
            
            if (animate) {
                isAnimating = true;
                setTimeout(() => { isAnimating = false; }, 700);
            }
            
            // Calculate position: show current slide in center with peeks
            const translateX = -33.333 - (currentSlide * 33.333);
            track.style.transform = `translateX(${translateX}%)`;
            
            // Update slide scales and opacity
            slides.forEach((slide, idx) => {
                const slideIndex = idx % totalSlides;
                if (slideIndex === currentSlide) {
                    slide.classList.remove('opacity-50', 'scale-90');
                    slide.classList.add('scale-100');
                } else {
                    slide.classList.remove('scale-100');
                    slide.classList.add('opacity-50', 'scale-90');
                }
            });
            
            // Update indicators
            indicators.forEach((indicator, idx) => {
                if (idx === currentSlide) {
                    indicator.classList.remove('bg-white/50');
                    indicator.classList.add('bg-white');
                } else {
                    indicator.classList.remove('bg-white');
                    indicator.classList.add('bg-white/50');
                }
            });
        }
        
        // Next slide with rotation
        nextButton.addEventListener('click', () => {
            if (isAnimating) return;
            currentSlide = (currentSlide + 1) % totalSlides;
            updateCarousel();
        });
        
        // Previous slide with rotation
        prevButton.addEventListener('click', () => {
            if (isAnimating) return;
            currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
            updateCarousel();
        });
        
        // Indicator clicks
        indicators.forEach((indicator, idx) => {
            indicator.addEventListener('click', () => {
                if (isAnimating) return;
                currentSlide = idx;
                updateCarousel();
            });
        });
        
        // Auto-rotation with smooth transitions
        let autoRotateInterval = setInterval(() => {
            if (!isAnimating) {
                currentSlide = (currentSlide + 1) % totalSlides;
                updateCarousel();
            }
        }, 4000);
        
        // Pause auto-rotation on hover
        const container = document.querySelector(`.carousel-container-${index}`);
        container.addEventListener('mouseenter', () => {
            clearInterval(autoRotateInterval);
        });
        
        container.addEventListener('mouseleave', () => {
            autoRotateInterval = setInterval(() => {
                if (!isAnimating) {
                    currentSlide = (currentSlide + 1) % totalSlides;
                    updateCarousel();
                }
            }, 4000);
        });
        
        // Initialize first slide
        updateCarousel(false);
    }
});
</script>