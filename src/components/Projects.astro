---
import projectData from './Data/Projects.json';
---

<section class="overflow-hidden bg-black pt-14 pb-32 space-y-24" id="projects">
    <div class="self-stretch overflow-hidden flex flex-row items-center justify-center py-5 px-0 gap-[16px]">
        <h2 class="text-white py-5 text-4xl font-bold sm:text-4xl md:text-5xl"><span class="font-medium">My</span> Projects</h2>
    </div>
    
    {projectData.map((project, index) => (
        <div class="relative">
            <div class={`lg:mx-auto lg:grid lg:max-w-7xl lg:grid-flow-col-dense lg:grid-cols-2 lg:gap-24 lg:px-8 ${index % 2 === 1 ? 'lg:grid-flow-col-dense' : ''}`}>
                <div class={`mx-auto max-w-xl px-6 lg:mx-0 lg:max-w-none lg:py-16 lg:px-0 ${index % 2 === 1 ? 'lg:col-start-2' : ''}`}>
                    <div>
                        <h3 class="text-2xl font-bold tracking-tight text-white">
                            {String(index + 1).padStart(2, '0')}
                        </h3>
                        <div class="mt-6">
                            <h2 class="text-3xl font-bold tracking-tight text-white">
                                {project.name}
                            </h2>
                            <p class="mt-4 text-lg text-zinc-500 sm:text-sm">
                                {project.description}
                            </p>
                            <div class="mt-4 flex flex-wrap gap-2">
                                {project.tags && project.tags.map(tag => (
                                    <span class="px-3 py-1 bg-zinc-800 text-zinc-300 text-sm rounded-full">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                            <div class="mt-6">
                                <a href={project.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-white hover:text-zinc-300 transition-colors">
                                    <span>View Project</span>
                                    <img class="social-icon" alt="read-more" src="/read-more.svg" />
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-12 sm:mt-16 lg:mt-0">
                    <div class="mx-4 md:mx-2 lg:relative lg:m-0 lg:h-full lg:px-0">
                        <img 
                            loading="lazy" 
                            alt={project.name}
                            class={`w-full rounded-xl shadow-2xl ring-1 ring-black ring-opacity-5 lg:absolute ${index % 2 === 1 ? 'lg:right-0' : 'lg:left-0'} lg:h-full lg:w-auto lg:max-w-none`}
                            style="color:transparent" 
                            src={`https://images.pexels.com/photos/${project.id === 1 ? '590022' : project.id === 2 ? '8386440' : '270348'}/pexels-photo-${project.id === 1 ? '590022' : project.id === 2 ? '8386440' : '270348'}.jpeg?auto=compress&cs=tinysrgb&w=800`}
                        />
                    </div>
                </div>
            </div>
        </div>
    ))}
</section>